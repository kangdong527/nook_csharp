  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "//overrides": "next@14.2.35 가 postcss@8.4.31 을 중첩 고정해 high 취약점 7건이 남는다. postcss 8.x 는 semver 호환이라 최신 8.5.x 로 통일한다. next 를 major(16)로 올리는 대신 선택한 조치이며, next 업그레이드 시 이 항목이 불필요해지는지 재확인할 것.",
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.13",
    "typescript": "^5"
  }
}
