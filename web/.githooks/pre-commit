#!/bin/sh
# main 브랜치 직접 커밋 차단 (CLAUDE.md "하지 말 것" 5번)
# GitHub Free + private 저장소는 브랜치 보호 규칙을 쓸 수 없어 로컬 훅으로 대체한다.
# 활성화: git config core.hooksPath .githooks   (클론 후 1회)

branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ]; then
  echo ""
  echo "  ✗ main 브랜치에 직접 커밋할 수 없습니다."
  echo ""
  echo "    작업 브랜치를 만든 뒤 커밋하세요:"
  echo "      git switch -c feat/작업이름"
  echo ""
  echo "    이미 스테이징한 변경은 그대로 유지됩니다."
  echo "    긴급 우회가 필요하면: git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
