<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nook.Application\Nook.Application.csproj" />
    <ProjectReference Include="..\Nook.Domain\Nook.Domain.csproj" />
    <ProjectReference Include="..\Nook.SharedKernel\Nook.SharedKernel.csproj" />
  </ItemGroup>

  <!-- BackgroundService·Options 바인딩·ILogger. 런타임과 같은 버전이 따라와 패키지 버전을 따로 관리하지 않는다 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.11" />
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.106.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- 발송 경계(메일 큐·워커·발송기)는 internal 이다 — Api 는 DI 확장 메서드로만 고른다. 통합 테스트만 안을 본다(DEP 7단계 A1) -->
  <ItemGroup>
    <InternalsVisibleTo Include="Nook.Integration.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
