# 매일 04:00 KST 에 nook-backup.service. DEP 9단계, Claude 작성(2026-11-11). 결정(사용자): 04:00 KST, 하루 1회(RPO 24시간)
# 다음 실행 시각 보기: systemctl list-timers nook-backup.timer
[Unit]
Description=Daily nook DB backup (04:00 KST)

[Timer]
# EC2 시계는 UTC → 시간대를 명시한다(없으면 04:00 UTC = 13:00 KST)
OnCalendar=*-*-* 04:00:00 Asia/Seoul
# 그 시각에 꺼져 있었으면(정지·재부팅) 다음 부팅 때 놓친 1회를 바로 돌린다
Persistent=true

[Install]
WantedBy=timers.target
