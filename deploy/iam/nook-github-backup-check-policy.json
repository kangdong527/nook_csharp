{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupKeysUnderDaily",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::nook-prod-backups-<ACCOUNT_ID>-ap-northeast-2-an",
      "Condition": {
        "StringLike": { "s3:prefix": "daily/*" }
      }
    },
    {
      "Sid": "DescribeSnapshotsSeoulOnly",
      "Effect": "Allow",
      "Action": "ec2:DescribeSnapshots",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" }
      }
    }
  ]
}
