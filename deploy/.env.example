# deploy/compose.yaml 용. deploy/.env 로 복사해 채운다. .env 는 커밋하지 않는다(.gitignore).
# 운영(6단계)에서는 이 파일 대신 SSM Parameter Store 에서 읽어 만든다.

# 브라우저 주소창의 출처(스킴+호스트+포트, 끝 슬래시 없음). BFF Origin 검사·로그인 링크 주소에 쓴다
NOOK_PUBLIC_ORIGIN=http://localhost:3300
# Caddy 사이트 주소. 로컬은 http:// 를 붙여 인증서 없이, 운영은 도메인만(자동 HTTPS)
SITE_ADDRESS=http://localhost:3300

POSTGRES_DB=nook
POSTGRES_USER=nook
# 생성 예: openssl rand -base64 24
POSTGRES_PASSWORD=
# HS256 서명 키, 32바이트 이상. 생성 예: openssl rand -base64 48
JWT_SIGNING_KEY=

# 카카오 JavaScript 키(공개 값 — 플랫폼에 등록한 도메인에서만 동작). 빌드 때 번들에 들어간다
NEXT_PUBLIC_KAKAO_MAP_KEY=
